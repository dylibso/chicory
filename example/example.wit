package example:example;

world example {
  // Type definitions
  record person {
    name: string,
    age: s32,
    active: bool,
  }

  // Exports: Functions guest provides to host
  export add: func(a: s32, b: s32) -> s32;
  export multiply: func(a: s64, b: s64) -> s64;
  export is-positive: func(x: s32) -> bool;
  export greet: func(name: string) -> string;
  export process-text: func(text: string) -> string;
  
  // Exports that test calling imported functions
  export test-host-call-log: func(msg: string);
  export test-host-call-get-input: func() -> string;
  
  // Exports that test record support
  export describe-person: func(p: person) -> string;
  export create-person: func(name: string, age: s32) -> person;
  
  // Imports: Functions guest needs from host
  import host-log: func(msg: string);
  import host-get-input: func() -> string;
}
